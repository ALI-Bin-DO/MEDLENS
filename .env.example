# Copy this file to .env and replace the two passwords with your own. Never commit .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=medlens

# Admin account: used ONLY by database/load_data.py (needs write access).
# The backend app never reads these two.
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password_here

# Read-only account from database/readonly_user.sql.
# The backend app connects with this account only; there is no fallback to root.
MYSQL_READONLY_USER=medlens_readonly
MYSQL_READONLY_PASSWORD=change_this_password

# --- Read-only query execution limits (all optional; defaults shown) ---
# Seconds to wait when opening a MySQL connection.
MYSQL_CONNECT_TIMEOUT_SECONDS=5
# Server-side time limit for each SELECT, in milliseconds (SESSION max_execution_time).
MYSQL_MAX_EXECUTION_MS=5000
# Connector socket read/write timeout in whole seconds; must be longer than MYSQL_MAX_EXECUTION_MS
# so the server's own limit fires first with a clear error.
MYSQL_IO_TIMEOUT_SECONDS=10
# Most rows returned per query; extra rows are not fetched and the result is marked truncated.
MYSQL_ROW_CAP=200

# --- Local LLM via Ollama (required: SQL generation and embeddings) ---
# Address of the local Ollama server (11434 is Ollama's default port).
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 (::1) first and Ollama's
# IPv4-only listener refuses it after about 2 seconds, which delays every request.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama model that writes SQL (download: ollama pull qwen3.5:4b).
OLLAMA_SQL_MODEL=qwen3.5:4b
# Seconds to wait for one SQL-generation request (finite, > 0). Optional; default 180.
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
# Context window for SQL generation, in tokens; the whole prompt plus the output must fit.
# A prompt that would not fit is refused, never cut. Optional; default 4096.
OLLAMA_SQL_NUM_CTX=4096
# Maximum tokens the model may generate; hitting this limit counts as a failed generation. Optional; default 512.
OLLAMA_SQL_NUM_PREDICT=512
# Ollama model that produces embeddings for RAG (download: ollama pull nomic-embed-text:v1.5).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Seconds to wait for one embedding request before failing (finite, > 0). Optional; default 60.
OLLAMA_TIMEOUT_SECONDS=60

# --- Qdrant vector store (local mode; built by python -m backend.scripts.build_index) ---
# Folder for Qdrant's local files; relative paths are from the project root. Git-ignored.
QDRANT_PATH=storage/qdrant
# Name of the collection that holds the knowledge-base chunks.
QDRANT_COLLECTION=medlens_knowledge

# --- API (POST /chat) ---
# Longest accepted question, in characters (blank questions are always rejected). Optional; default 500.
CHAT_MAX_QUESTION_CHARS=500
# Questions allowed to WAIT while one is running (one GPU = one at a time). Beyond this, /chat
# answers 503 "busy" with Retry-After instead of queueing without limit. Optional; default 1.
CHAT_MAX_WAITING_REQUESTS=1
# Comma-separated frontend origins allowed by CORS, e.g. http://127.0.0.1:5173. Empty = no CORS.
# Must be explicit origins; "*" is refused. Optional; default empty.
CORS_ALLOWED_ORIGINS=

# Most result rows for which /chat still returns a chart; above this, chart is null. Optional; default 50.
CHART_MAX_POINTS=50

# --- CSV export (POST /export/csv); all optional, defaults shown ---
# Largest request body in bytes (refused while reading, before it is fully loaded).
EXPORT_MAX_BYTES=2000000
EXPORT_MAX_COLUMNS=100
EXPORT_MAX_ROWS=10000
# Longest text cell or column name, in characters.
EXPORT_MAX_CELL_CHARS=10000

# --- Request monitoring (/admin/metrics, /admin/activity); all optional, defaults shown ---
# Local SQLite file for POST /chat metadata events (never MySQL or Qdrant). Git-ignored.
MONITORING_DB_PATH=storage/monitoring/medlens_monitoring.sqlite3
# Events older than this many days are deleted (keep >= 7 for the 7d window).
MONITORING_RETENTION_DAYS=30
# Only the newest N events are kept.
MONITORING_MAX_EVENTS=50000

# --- System status (GET /admin/system); optional, defaults shown ---
# Seconds a status snapshot is reused before probing again.
SYSTEM_STATUS_CACHE_SECONDS=15
# Per-call timeout for status probes (Ollama metadata, MySQL SELECT 1), whole seconds.
SYSTEM_PROBE_TIMEOUT_SECONDS=3

# --- Conversations (in memory only; lost on restart); optional, defaults shown ---
# A conversation expires after this many seconds without use.
CONVERSATION_TTL_SECONDS=1800
# Most conversations kept at once; the least recently used idle one is evicted.
CONVERSATION_MAX_COUNT=200
# Most successful data turns kept per conversation (question, resolved question, executed SQL).
CONVERSATION_MAX_TURNS=5

# --- LLM context: "full schema + retrieved documentation/examples" ---
# How many documentation/example chunks to retrieve per question (0 = schema only).
# All schema chunks are always included and do not count toward this number. Optional; default 5.
RAG_CONTEXT_TOP_K=5
